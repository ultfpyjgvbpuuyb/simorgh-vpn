# --- Panel ---
ADMIN_USER=admin
ADMIN_PASS=change-me-to-a-long-password
PANEL_SECRET=run: python3 -c "import secrets;print(secrets.token_hex(32))"
PANEL_PORT=8000
# Public URL of the panel as users see it (used in subscription links)
PUBLIC_BASE_URL=https://panel.example.com:8443
SUPPORT_URL=https://t.me/your_support

# --- Xray (VLESS + Reality) ---
SERVER_HOST=your.server.ip.or.domain
XRAY_PORT=443
# generate with: xray x25519   (Private key -> REALITY_PRIVATE_KEY, Public key -> REALITY_PUBLIC_KEY)
REALITY_PRIVATE_KEY=
REALITY_PUBLIC_KEY=
REALITY_SNI=www.cloudflare.com
# generate with: openssl rand -hex 8
REALITY_SHORT_ID=
